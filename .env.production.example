# PostgreSQL (runs in docker-compose on EC2)
POSTGRES_USER=pribilka
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=pribilka

DATABASE_URL=postgresql://pribilka:CHANGE_ME_STRONG_PASSWORD@db:5432/pribilka
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

DEFAULT_COUNTRY=PL
DEBUG=false

# Telegram alerts for broken scrapers (recommended)
ADMIN_TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=
COLLECTOR_ALERT_COOLDOWN_HOURS=12
DEPOSIT_TRANSIENT_ERROR_ALERT_THRESHOLD=3

# Admin API — GET /api/v1/admin/collector-status
ADMIN_API_KEY=CHANGE_ME_LONG_RANDOM_KEY

# Firebase Cloud Messaging (push notifications to ZyskRadar app)
# Service account JSON from Firebase Console → zyskradar → Service accounts
FIREBASE_PROJECT_ID=zyskradar
FIREBASE_CREDENTIALS_JSON=

# Optional: OpenAI enhancement for /insights endpoints
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
