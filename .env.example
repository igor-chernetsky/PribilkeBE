DATABASE_URL=postgresql://pribilka:pribilka@localhost:5432/pribilka
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
DEFAULT_COUNTRY=PL
DEBUG=true

# Admin alerts when deposit parsers fail (optional)
# ADMIN_TELEGRAM_BOT_TOKEN=
# ADMIN_TELEGRAM_CHAT_ID=
# ADMIN_WEBHOOK_URL=
# COLLECTOR_ALERT_COOLDOWN_HOURS=12

# Admin read API — collector status (optional)
# ADMIN_API_KEY=change-me-to-a-long-random-string

# Firebase Cloud Messaging (push notifications to ZyskRadar app)
# Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_PROJECT_ID=zyskradar
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"zyskradar",...}

# OpenAI — product insights and weekly market digest (template fallback without key)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
