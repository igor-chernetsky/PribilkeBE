DATABASE_URL=postgresql://pribilka:pribilka@localhost:5432/pribilka
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
DEFAULT_COUNTRY=PL
DEBUG=true

# Admin alerts when deposit parsers fail (optional)
# ADMIN_TELEGRAM_BOT_TOKEN=
# ADMIN_TELEGRAM_CHAT_ID=
# ADMIN_WEBHOOK_URL=
# COLLECTOR_ALERT_COOLDOWN_HOURS=12

# Admin read API — collector status (optional)
# ADMIN_API_KEY=change-me-to-a-long-random-string

# Firebase Cloud Messaging (optional — push notifications)
# FIREBASE_PROJECT_ID=your-firebase-project
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# OpenAI — optional enhancement for /insights (rule-based works without it)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
